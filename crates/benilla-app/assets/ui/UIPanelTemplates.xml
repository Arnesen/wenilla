    <!-- ref l.125-165. The scroll bar itself: a Slider carrying its two step buttons as nested
         frames, so `$parentScrollUpButton`/`$parentScrollDownButton` publish under the OWNER's
         name two levels down (`MyScrollScrollBarScrollUpButton`) — which is exactly what
         `ScrollFrame_OnLoad` and `FauxScrollFrame_Update` getglobal for. The value model here is
         the REFERENCE's: `OnValueChanged` pushes the value straight into the parent ScrollFrame's
         `SetVerticalScroll`, i.e. pixels of pan. (benilla's own `BenillaScrollBarTemplate` in
         ScrollTemplates.xml is the faux twin of this — same art and same child names, but its
         OnValueChanged drives a row offset instead. Both are needed: ours serves our windows, this
         serves an addon that names the reference template.) -->
    <Slider name="UIPanelScrollBarTemplate" virtual="true">
        <Size><AbsDimension x="16" y="0"/></Size>
        <Frames>
            <!-- Both arrows step by half a bar-height and differ only in sign; unlike the wheel,
                 both click. -->
            <Button name="$parentScrollUpButton" inherits="UIPanelScrollUpButtonTemplate">
                <Anchors><Anchor point="BOTTOM" relativePoint="TOP"/></Anchors>
                <Scripts>
                    <OnClick>
                        local bar = this:GetParent()
                        bar:SetValue(bar:GetValue() - bar:GetHeight() / 2)
                        PlaySound("UChatScrollButton")
                    </OnClick>
                </Scripts>
            </Button>
            <Button name="$parentScrollDownButton" inherits="UIPanelScrollDownButtonTemplate">
                <Anchors><Anchor point="TOP" relativePoint="BOTTOM"/></Anchors>
                <Scripts>
                    <OnClick>
                        local bar = this:GetParent()
                        bar:SetValue(bar:GetValue() + bar:GetHeight() / 2)
                        PlaySound("UChatScrollButton")
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>
        <Scripts>
            <OnValueChanged>this:GetParent():SetVerticalScroll(arg1)</OnValueChanged>
        </Scripts>
        <ThumbTexture name="$parentThumbTexture" inherits="UIPanelScrollBarButton" file="Interface\Buttons\UI-ScrollBar-Knob">
            <Size><AbsDimension x="16" y="16"/></Size>
            <TexCoords left="0.25" right="0.75" top="0.25" bottom="0.75"/>
        </ThumbTexture>
    </Slider>

    <!-- ref l.166-212. The REAL scroll frame: an engine `<ScrollFrame>` that pans and clips a
         scroll child, with the bar above pinned down its right edge (inset 16 top and bottom so
         the arrow buttons sit inside the track span). 6 call sites across 2 corpus addons.

         `ScrollFrame_OnLoad` — the reference's own name for it — is declared in ScrollTemplates.xml;
         the other two handlers are this file's script block. An instance supplies its own
         `<ScrollChild>` — without one the frame has no scroll range at all, which the loader now
         says out loud. -->
    <ScrollFrame name="UIPanelScrollFrameTemplate" virtual="true">
        <Frames>
            <Slider name="$parentScrollBar" inherits="UIPanelScrollBarTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="TOPRIGHT"><Offset><AbsDimension x="6" y="-16"/></Offset></Anchor>
                    <Anchor point="BOTTOMLEFT" relativePoint="BOTTOMRIGHT"><Offset><AbsDimension x="6" y="16"/></Offset></Anchor>
                </Anchors>
            </Slider>
        </Frames>
        <Scripts>
            <OnLoad>ScrollFrame_OnLoad()</OnLoad>
            <OnScrollRangeChanged>ScrollFrame_OnScrollRangeChanged(arg2)</OnScrollRangeChanged>
            <!-- Each arrow is live only while there is somewhere its way to go: up dies at offset
                 zero, down dies once the bar has been seated at the top of its range. The bar's
                 own value is re-read for the down test rather than arg1 being reused, because
                 SetValue above may have clamped it. (The reference's comment on this pair reads
                 "The code to disable the ScrollDownButton is pretty hacked, but it works" — it
                 asks the same question as `(value - max) == 0`.) -->
            <OnVerticalScroll>
                local scrollbar = getglobal(this:GetName() .. "ScrollBar")
                scrollbar:SetValue(arg1)
                local up = getglobal(scrollbar:GetName() .. "ScrollUpButton")
                local down = getglobal(scrollbar:GetName() .. "ScrollDownButton")
                local _, maxScroll = scrollbar:GetMinMaxValues()
                if arg1 == 0 then up:Disable() else up:Enable() end
                if scrollbar:GetValue() == maxScroll then down:Disable() else down:Enable() end
            </OnVerticalScroll>
            <OnMouseWheel>ScrollFrameTemplate_OnMouseWheel(arg1)</OnMouseWheel>
        </Scripts>
    </ScrollFrame>

    <!-- ref l.226-279. The standard text box: a three-slice Common-Input-Border under an EditBox,
