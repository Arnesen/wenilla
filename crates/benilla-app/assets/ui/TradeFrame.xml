<Ui>
    <!--
        benilla's player-to-player trade window (decision 0592 P1). The geometry/art/texcoords are
        transcribed from the reference `TradeFrame.xml` (WoW/_extracted_framexml/TradeFrame.xml) —
        sizes, offsets, anchors, art files, texcoords — adapted only in (a) naming (every `Foo` →
        `BenillaFoo`) and (b) feed/intent wiring onto the trade script API
        (`benilla-ui/src/script/trade.rs`) + `crate::ui_trade`'s feed/drain. The house dressing
        convention (decisions 0084/0112/0120/0544).

        Where the reference inherits a shared template benilla does NOT ship (ItemButtonTemplate,
        UIPanelButtonTemplate, UIPanelCloseButton, MoneyInputFrameTemplate, SmallMoneyFrameTemplate),
        the body is inlined with the reference's own geometry/art (the MailFrame.xml precedent). The
        two money displays reuse `MerchantFrame.xml`'s global `BenillaMoney_*` coin trio (read-only in
        P1); the reference's editable `MoneyInputFrame` on the player's side is decision 0592 P2.

        SCOPE (decision 0592 P1): the window opens on an incoming/initiated trade and mirrors both
        sides' items + gold live, the partner's portrait (the shared "npc" booth) + name, and the
        accept glow; the Trade/Cancel buttons drive the accept/cancel verbs. DEFERRED to P2: setting
        items/gold onto the window (the drag-drop slots + the editable money widget), so the item
        slots carry NO OnClick/OnEnter here, and the slot tooltips (GameTooltip:SetTradePlayerItem)
        are P2. The enchant-slot spell name (slot 7's "enchantment") is decision 0592 P3.
    -->
    <Script><![CDATA[
        MAX_TRADE_ITEMS = 7    -- MAX_TRADE_ITEMS (ref TradeFrame.lua l.1)

        -- One side's accept glow. A column's highlight and the enchant slot's below it are one
        -- indicator in two frames — they light and drop together, never apart — so both the repaint
        -- and TradeFrame_SetAcceptState go through here rather than each spelling out four calls.
        -- The four frames are TradeHighlight{Player,Recipient}[Enchant], declared at the bottom.
        local function setTradeGlow(column, enchantSlot, lit)
            if lit then
                column:Show()
                enchantSlot:Show()
            else
                column:Hide()
                enchantSlot:Hide()
            end
        end

        -- ── Load / event dispatch (ref TradeFrame_OnLoad l.4 / TradeFrame_OnEvent l.18) ───────────
        function TradeFrame_OnLoad()
            local frame = this
            frame:RegisterEvent("TRADE_SHOW")
            frame:RegisterEvent("TRADE_UPDATE")
            frame:RegisterEvent("TRADE_CLOSED")
            frame:RegisterEvent("TRADE_PLAYER_ITEM_CHANGED")
            frame:RegisterEvent("TRADE_TARGET_ITEM_CHANGED")
            frame:RegisterEvent("TRADE_ACCEPT_UPDATE")
            -- Our accepted gold, echoed back so the input reflects the server's clamp (ref
            -- TradePlayerInputMoneyFrame's own PLAYER_TRADE_MONEY registration, l.565). Kept off the
            -- general TRADE_UPDATE repaint so it never overwrites what the player is mid-typing.
            frame:RegisterEvent("PLAYER_TRADE_MONEY")
        end

        function TradeFrame_OnEvent()
            local frame = this
            if event == "TRADE_SHOW" or event == "TRADE_UPDATE" then
                ShowUIPanel(frame)
                if not frame:IsVisible() then
                    CloseTrade()
                    return
                end
                TradeFrameTradeButton:Enable()
                TradeFrame_Update()
            elseif event == "PLAYER_TRADE_MONEY" then
                BenillaMoneyInput_SetCopper("TradePlayerInputMoney", GetPlayerTradeMoney())
            elseif event == "TRADE_CLOSED" then
                HideUIPanel(frame)
            elseif event == "TRADE_PLAYER_ITEM_CHANGED" then
                TradeFrame_UpdatePlayerItem(arg1)
            elseif event == "TRADE_TARGET_ITEM_CHANGED" then
                TradeFrame_UpdateTargetItem(arg1)
            elseif event == "TRADE_ACCEPT_UPDATE" then
                TradeFrame_SetAcceptState(arg1, arg2)
            end
        end

        function TradeFrame_OnShow()
            TradeFrame.acceptState = 0
        end

        function TradeFrame_OnHide()
            -- The client-side close verb (ref TradeFrame_OnHide l.144) → CMSG_CANCEL_TRADE + a local
            -- clear (the app's drain); clear our money entry so a later trade opens fresh (ref l.146).
            BenillaMoneyInput_ResetMoney("TradePlayerInputMoney")
            CloseTrade()
        end

        -- A keystroke in our money input (ref TradeFrame_UpdateMoney l.162): read the copper total,
        -- clamp to what we actually carry, and offer it → SetTradeMoney → CMSG_SET_TRADE_GOLD.
        function TradeFrame_UpdateMoney()
            local copper = BenillaMoneyInput_GetCopper("TradePlayerInputMoney")
            if GetMoney and copper > GetMoney() then
                copper = GetPlayerTradeMoney()
                BenillaMoneyInput_SetCopper("TradePlayerInputMoney", copper)
            end
            SetTradeMoney(copper)
        end

        -- ── Full repaint (ref TradeFrame_Update l.39): portraits, names, all 7 slots each side, the
        --    two money displays, the accept highlights hidden. ────────────────────────────────────
        function TradeFrame_Update()
            SetPortraitTexture(TradeFramePlayerPortrait, "player")
            -- The partner rides the shared "npc" portrait booth (the app points it at the partner
            -- entity, decision 0592); the name comes from GetTradePartnerName() in place of the
            -- reference's UnitName("NPC").
            SetPortraitTexture(TradeFrameRecipientPortrait, "npc")
            TradeFramePlayerNameText:SetText(UnitName("player") or "")
            TradeFrameRecipientNameText:SetText(GetTradePartnerName() or "")
            for i = 1, MAX_TRADE_ITEMS do
                TradeFrame_UpdatePlayerItem(i)
                TradeFrame_UpdateTargetItem(i)
            end
            -- Our gold is the editable input, reflected via PLAYER_TRADE_MONEY (not repainted here, so
            -- the repaint never clobbers mid-typing); only the partner's read-only gold repaints.
            BenillaMoney_Set("TradeRecipientMoneyFrame", GetTargetTradeMoney())
            -- A repaint puts both glows down. TRADE_ACCEPT_UPDATE is the only thing that raises
            -- them, so whatever is standing comes straight back on the next one.
            setTradeGlow(TradeHighlightPlayer, TradeHighlightPlayerEnchant, false)
            setTradeGlow(TradeHighlightRecipient, TradeHighlightRecipientEnchant, false)
        end

        -- One slot's paint, shared by both columns (ref TradeFrame_UpdatePlayerItem l.54 /
        -- UpdateTargetItem l.83). `isTarget` gates the recipient-only not-usable red tint.
        function BenillaTradeSlot_SetItem(prefix, id, name, texture, numItems, isUsable, enchantment, isTarget)
            local nameText = getglobal(prefix.."Name")
            local icon = getglobal(prefix.."ItemButtonIcon")
            local count = getglobal(prefix.."ItemButtonCount")
            -- The enchant slot (id 7): the enchant name (P3) or the "will not be traded" note.
            if id == MAX_TRADE_ITEMS then
                if name then
                    if enchantment then
                        nameText:SetText("|cff20ff20"..enchantment.."|r")
                    else
                        nameText:SetText("|cffffffffWill Not Be Traded|r")
                    end
                else
                    nameText:SetText("")
                end
            else
                nameText:SetText(name or "")
            end
            if texture then
                icon:SetTexture(texture)
                icon:Show()
            else
                icon:Hide()
            end
            if numItems and numItems > 1 then
                count:SetText(numItems)
                count:Show()
            else
                count:SetText("")
                count:Hide()
            end
            -- The recipient not-usable red tint (ref l.105-113): red when the partner offers an item
            -- our class/level/skill can't use; white otherwise (and always white on our own column).
            local slotTex = getglobal(prefix.."SlotTexture")
            local nameFrame = getglobal(prefix.."NameFrame")
            if isTarget and name and not isUsable then
                icon:SetVertexColor(0.9, 0, 0)
                nameFrame:SetVertexColor(0.9, 0, 0)
                slotTex:SetVertexColor(1.0, 0, 0)
            else
                icon:SetVertexColor(1, 1, 1)
                nameFrame:SetVertexColor(1, 1, 1)
                slotTex:SetVertexColor(1, 1, 1)
            end
        end

        function TradeFrame_UpdatePlayerItem(id)
            local name, texture, numItems, isUsable, enchantment = GetTradePlayerItemInfo(id)
            BenillaTradeSlot_SetItem("TradePlayerItem"..id, id, name, texture, numItems, isUsable, enchantment, nil)
        end

        function TradeFrame_UpdateTargetItem(id)
            local name, texture, numItems, quality, isUsable, enchantment = GetTradeTargetItemInfo(id)
            BenillaTradeSlot_SetItem("TradeRecipientItem"..id, id, name, texture, numItems, isUsable, enchantment, 1)
        end

        -- A trade slot's item button as a cursor drop target (decision 0592 P2, ref ClickTradeButton /
        -- ClickTargetTradeButton, TradeFrame.xml l.135/101). Both columns share the slot template, so
        -- player-vs-recipient is read off the slot frame's name; the slot number is its frame id. Our
        -- slot drops/clears a bag item (SET/CLEAR_TRADE_ITEM); the partner's column is read-only.
        function BenillaTradeSlot_OnClick(button)
            local slot = button:GetParent()
            local id = slot:GetID()
            if string.find(slot:GetName(), "Player", 1, true) then
                ClickTradeButton(id)
            else
                ClickTargetTradeButton(id)
            end
        end

        -- Who has pressed Trade (spec: ref TradeFrame_SetAcceptState l.116). The event carries BOTH
        -- sides' states, so this is a straight repaint of two indicators rather than a toggle — and
        -- our own half is kept on the frame, because the Cancel button below is the only reader of
        -- whether there is an accept of ours to withdraw.
        --
        -- The extra thing our own accept does is lock the Trade button, so a standing accept cannot
        -- be sent a second time; Cancel is what takes it back.
        function TradeFrame_SetAcceptState(playerState, targetState)
            TradeFrame.acceptState = playerState
            local weAccepted = playerState == 1
            setTradeGlow(TradeHighlightPlayer, TradeHighlightPlayerEnchant, weAccepted)
            setTradeGlow(TradeHighlightRecipient, TradeHighlightRecipientEnchant, targetState == 1)
            if weAccepted then
                TradeFrameTradeButton:Disable()
            else
                TradeFrameTradeButton:Enable()
            end
        end

        -- Cancel is two verbs on one button (spec: ref TradeFrameCancelButton_OnClick l.136). With
        -- an accept of ours standing it withdraws only THAT and the trade stays open — the button
        -- is the only way back out of the lock above. With no accept up there is nothing to
        -- withdraw, so it means "leave", and closing the window is what sends that (→ OnHide →
        -- CloseTrade).
        function TradeFrameCancelButton_OnClick()
            if TradeFrame.acceptState ~= 1 then
                HideUIPanel(TradeFrame)
                return
            end
            CancelTradeAccept()
        end
    ]]></Script>

    <!-- The accept-glow highlight (ref TradeHighlightTemplate l.4): a 3-slice UI-TradeFrame-Highlight
         (top/bottom caps + a stretched middle), sized per-instance. -->
    <Frame name="BenillaTradeHighlightTemplate" hidden="false" virtual="true">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentTop" file="Interface\TradeFrame\UI-TradeFrame-Highlight">
                    <Size><AbsDimension x="161" y="16"/></Size>
                    <Anchors><Anchor point="TOPLEFT"/></Anchors>
                    <TexCoords left="0" right="0.62890625" top="0" bottom="0.0625"/>
                </Texture>
                <Texture name="$parentBottom" file="Interface\TradeFrame\UI-TradeFrame-Highlight">
                    <Size><AbsDimension x="161" y="16"/></Size>
                    <Anchors><Anchor point="BOTTOMLEFT"/></Anchors>
                    <TexCoords left="0" right="0.62890625" top="0.9375" bottom="1.0"/>
                </Texture>
                <Texture name="$parentMiddle" file="Interface\TradeFrame\UI-TradeFrame-Highlight">
                    <Size><AbsDimension x="161" y="10"/></Size>
                    <Anchors>
                        <Anchor point="TOP" relativeTo="$parentTop" relativePoint="BOTTOM"/>
                        <Anchor point="BOTTOM" relativeTo="$parentBottom" relativePoint="TOP"/>
                    </Anchors>
                    <TexCoords left="0" right="0.62890625" top="0.0625" bottom="0.9375"/>
                </Texture>
            </Layer>
        </Layers>
    </Frame>

    <!-- One trade slot (ref TradeItemTemplate l.38 + PlayerTradeItemTemplate's inlined ItemButton
         l.120): the empty-slot art, the name plate, the item name, and a 37px item button (icon +
         stack count). Display-only in P1 — no OnClick/OnEnter (decision 0592 P2). -->
    <Frame name="BenillaTradeItemTemplate" virtual="true">
        <Size><AbsDimension x="153" y="37"/></Size>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentSlotTexture" file="Interface\Buttons\UI-EmptySlot">
                    <Size><AbsDimension x="64" y="64"/></Size>
                    <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="-13" y="13"/></Offset></Anchor></Anchors>
                </Texture>
                <Texture name="$parentNameFrame" file="Interface\QuestFrame\UI-QuestItemNameFrame">
                    <Size><AbsDimension x="124" y="64"/></Size>
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentSlotTexture" relativePoint="RIGHT"><Offset><AbsDimension x="-20" y="0"/></Offset></Anchor>
                    </Anchors>
                </Texture>
                <FontString name="$parentName" inherits="GameFontNormalSmall" text="" justifyH="LEFT">
                    <Size><AbsDimension x="90" y="30"/></Size>
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentNameFrame"><Offset><AbsDimension x="15" y="0"/></Offset></Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button name="$parentItemButton">
                <Size><AbsDimension x="37" y="37"/></Size>
                <Anchors><Anchor point="TOPLEFT" relativeTo="$parent"/></Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture name="$parentIcon" hidden="true" setAllPoints="true"/>
                    </Layer>
                    <Layer level="ARTWORK">
                        <FontString name="$parentCount" inherits="NumberFontNormal" hidden="true" justifyH="RIGHT">
                            <Anchors><Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="-2" y="2"/></Offset></Anchor></Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>
                <!-- A cursor drop target (decision 0592 P2): a click or a drag-release routes through
                     the shared slot handler, which places/clears on our side and is inert on the
                     partner's. Both gestures share one path, the reference's drag/click contract. -->
                <Scripts>
                    <OnClick>BenillaTradeSlot_OnClick(self)</OnClick>
                    <OnReceiveDrag>BenillaTradeSlot_OnClick(self)</OnReceiveDrag>
                </Scripts>
            </Button>
        </Frames>
    </Frame>

    <!-- The enchant / non-traded slot art (ref TradeRecipientItem7/TradePlayerItem7 l.393): the
         EnchantIcon overlay sits over slot 7's item button. A virtual twin of the base slot with the
         extra icon, instantiated only for id 7. -->
    <Frame name="BenillaTradeEnchantItemTemplate" inherits="BenillaTradeItemTemplate" virtual="true">
        <Frames>
            <Frame name="$parentEnchant" setAllPoints="false">
                <Size><AbsDimension x="62" y="62"/></Size>
                <Anchors><Anchor point="TOPLEFT"/></Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <Texture file="Interface\TradeFrame\UI-TradeFrame-EnchantIcon" setAllPoints="true"/>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>
    </Frame>

    <Frame name="TradeFrame" parent="UIParent" toplevel="true" movable="true" enableMouse="true" hidden="true">
