            </Frame>
            <Frame name="TradeRecipientItem4" inherits="BenillaTradeItemTemplate" id="4">
                <Anchors><Anchor point="TOPLEFT" relativeTo="TradeRecipientItem3" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-7"/></Offset></Anchor></Anchors>
