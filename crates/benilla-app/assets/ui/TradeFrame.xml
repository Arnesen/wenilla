                <Size><AbsDimension x="161" y="61"/></Size>
                <Anchors><Anchor point="TOPLEFT" relativeTo="TradeHighlightRecipient" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-4"/></Offset></Anchor></Anchors>
            </Frame>

            <!-- The partner's 6 trade slots + the 7th enchant slot (ref TradeRecipientItem1..7 l.331). -->
            <Frame name="TradeRecipientItem1" inherits="BenillaTradeItemTemplate" id="1">
                <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="195" y="-104"/></Offset></Anchor></Anchors>
            </Frame>
            <Frame name="TradeRecipientItem2" inherits="BenillaTradeItemTemplate" id="2">
                <Anchors><Anchor point="TOPLEFT" relativeTo="TradeRecipientItem1" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-7"/></Offset></Anchor></Anchors>
            </Frame>
            <Frame name="TradeRecipientItem3" inherits="BenillaTradeItemTemplate" id="3">
