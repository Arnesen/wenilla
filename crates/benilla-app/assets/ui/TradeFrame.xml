        <HitRectInsets><AbsInset left="0" right="35" top="0" bottom="72"/></HitRectInsets>
        <Layers>
            <Layer level="BACKGROUND">
                <!-- ref l.180: the two 60×60 unit portraits (recipient right, player left). -->
                <Texture name="TradeFrameRecipientPortrait">
                    <Size><AbsDimension x="60" y="60"/></Size>
                    <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="183" y="-6"/></Offset></Anchor></Anchors>
                </Texture>
                <Texture name="TradeFramePlayerPortrait">
                    <Size><AbsDimension x="60" y="60"/></Size>
                    <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="7" y="-6"/></Offset></Anchor></Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <!-- ref l.205: the four corner slabs. -->
                <Texture file="Interface\TradeFrame\UI-TradeFrame-TopLeft">
                    <Size><AbsDimension x="256" y="256"/></Size>
                    <Anchors><Anchor point="TOPLEFT"/></Anchors>
                </Texture>
                <Texture file="Interface\TradeFrame\UI-TradeFrame-TopRight">
                    <Size><AbsDimension x="128" y="256"/></Size>
                    <Anchors><Anchor point="TOPRIGHT"/></Anchors>
                </Texture>
                <Texture file="Interface\TradeFrame\UI-TradeFrame-BotLeft">
                    <Size><AbsDimension x="256" y="256"/></Size>
                    <Anchors><Anchor point="BOTTOMLEFT"/></Anchors>
                </Texture>
                <Texture file="Interface\TradeFrame\UI-TradeFrame-BotRight">
                    <Size><AbsDimension x="128" y="256"/></Size>
                    <Anchors><Anchor point="BOTTOMRIGHT"/></Anchors>
                </Texture>
                <FontString name="TradeFrameRecipientNameText" inherits="GameFontNormal" text="">
                    <Size><AbsDimension x="80" y="12"/></Size>
                    <Anchors><Anchor point="TOPLEFT" relativeTo="TradeFrame"><Offset><AbsDimension x="245" y="-17"/></Offset></Anchor></Anchors>
                </FontString>
                <FontString name="TradeFramePlayerNameText" inherits="GameFontNormal" text="">
                    <Size><AbsDimension x="100" y="12"/></Size>
                    <Anchors><Anchor point="TOPLEFT" relativeTo="TradeFrame"><Offset><AbsDimension x="75" y="-17"/></Offset></Anchor></Anchors>
                </FontString>
                <!-- ref l.262: the "Will Be Enchanted" column labels above the enchant slots. -->
                <FontString name="TradeFramePlayerEnchantText" inherits="GameFontHighlightSmall" text="Will Be Enchanted">
                    <Anchors><Anchor point="TOPLEFT" relativeTo="TradeFrame"><Offset><AbsDimension x="26" y="-374"/></Offset></Anchor></Anchors>
                </FontString>
                <FontString name="TradeFrameRecipientEnchantText" inherits="GameFontHighlightSmall" text="Will Be Enchanted">
                    <Anchors><Anchor point="LEFT" relativeTo="TradeFramePlayerEnchantText"><Offset><AbsDimension x="170" y="0"/></Offset></Anchor></Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <!-- The accept-glow highlights, one per column + its enchant slot (ref l.283). -->
            <Frame name="TradeHighlightPlayer" inherits="BenillaTradeHighlightTemplate" hidden="true">
                <Size><AbsDimension x="161" y="266"/></Size>
                <Anchors><Anchor point="TOPLEFT" relativeTo="TradeFrame"><Offset><AbsDimension x="19" y="-100"/></Offset></Anchor></Anchors>
            </Frame>
