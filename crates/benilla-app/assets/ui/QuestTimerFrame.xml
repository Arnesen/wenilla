                <FontString inherits="GameFontNormal" text="QUEST_TIMERS">
                    <Anchors>
                        <Anchor point="TOP" relativeTo="QuestTimerHeader"><Offset><AbsDimension x="0" y="-13"/></Offset></Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
