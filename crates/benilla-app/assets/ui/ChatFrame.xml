                <Scripts>
                    <OnLoad>
                        BenillaOnEmoteMenuLoad(BenillaVoiceMacroList)
                    </OnLoad>
                </Scripts>
            </Frame>
        </Frames>
        <Scripts>
            <OnLoad>
                BenillaChatMenu_OnLoad()
            </OnLoad>
