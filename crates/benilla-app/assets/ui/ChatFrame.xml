        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentLeft" file="Interface\ChatFrame\UI-ChatInputBorder-Left">
                    <Size><AbsDimension x="256" y="32"/></Size>
                    <Anchors><Anchor point="LEFT"/></Anchors>
                </Texture>
                <Texture name="$parentRight" file="Interface\ChatFrame\UI-ChatInputBorder-Right">
                    <Size><AbsDimension x="16" y="32"/></Size>
                    <Anchors><Anchor point="RIGHT"/></Anchors>
                    <TexCoords left="0.9375" right="1.0" top="0" bottom="1.0"/>
                </Texture>
                <Texture name="$parentMid" file="Interface\ChatFrame\UI-ChatInputBorder-Right">
                    <Size><AbsDimension x="1" y="32"/></Size>
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentLeft" relativePoint="RIGHT"/>
                        <Anchor point="RIGHT" relativeTo="$parentRight" relativePoint="LEFT"/>
                    </Anchors>
                    <TexCoords left="0" right="0.9375" top="0" bottom="1.0"/>
                </Texture>
