<Ui>
    <!--
        The chat window, rebuilt on the reference's own structure (decision 0288 P3): the docked
        General + Combat Log pair sharing ChatFrame1's rect, the hover-revealed tabs and
        background (the classic transparent chat — chat-cache.txt ships window alpha 0, hover
        fades to DEFAULT_CHATFRAME_ALPHA 0.25), the outside-left scroll column with the
        blinking bottom button, and the reference edit box (three-piece border art + header)
        below the frame. Geometry, art paths, timing constants, and behaviors are QUOTED from the
        extracted patch-chain FloatingChatFrame.xml/.lua + ChatFrame.xml/.lua (the pin in 0288);
        window management (drag/undock/resize/rename, the tab right-click options dropdown) is
        chat SETTINGS — deliberately out (0288 §2).

        The inbound feed (ui_chat::feed) AddMessages into ChatFrame1; the composer/router phase
        (0288 P4) fans CHAT_MSG groups across both windows per the chat-cache defaults. The edit
        box submits through SubmitChatInput → ui_chat::input's grammar; its live header machine
        (ChatEdit_UpdateHeader) is 0288 P5 — until then the header shows the sticky default
        "Say:" with static insets.
    -->
    <Script><![CDATA[
        -- ── BenillaFCF: the FloatingChatFrame behaviors, transcribed (ref FloatingChatFrame.lua)
        -- Quoted constants: CHAT_TAB_SHOW_DELAY=0.2, CHAT_FRAME_FADE_TIME=0.15,
        -- DEFAULT_CHATFRAME_ALPHA=0.25, CHAT_BUTTON_FLASH_TIME=0.5,
        -- MESSAGE_SCROLLBUTTON_INITIAL_DELAY=0, MESSAGE_SCROLLBUTTON_SCROLL_DELAY=0.05.
        BenillaFCF = {
            selected = 1,           -- SELECTED_DOCK_FRAME (1 = General, 2 = Combat Log)
            hover = false,          -- cursor inside the dock's padded rect
            hoverTime = 0,          -- stationary-cursor accumulator (ref: moving resets it)
            oldX = 0, oldY = 0,
            reveal = 0,             -- 0..1 master fade the tab/texture alphas scale by
            revealTarget = 0,
            flashTab = 0,           -- tab id whose whisper flash runs (0 = none), 0288 P4 wires it
            flashLeft = 0,          -- remaining flash seconds (ref: 60s, blink 0.25/0.25)
        }

        -- The per-window texture sets the hover fade drives (ref CHAT_FRAME_TEXTURES: the
        -- background + the 8 border pieces; benilla authors the borders as plain textures —
        -- resizing is settings, the hover LOOK is not). Global: the load-time tint below needs it.
        function BenillaFCF_Textures(id)
            local n = "ChatFrame" .. id
            local list = {}
            for _, suffix in ipairs({
                "Background",
                "BorderTopLeft", "BorderTopRight", "BorderBottomLeft", "BorderBottomRight",
                "BorderTop", "BorderBottom", "BorderLeft", "BorderRight",
            }) do
                local t = getglobal(n .. suffix)
                if t then table.insert(list, t) end
            end
            return list
        end

        -- FCF_SelectDockFrame: show the selected frame, hide the other; selected tab full alpha,
        -- unselected half (both still scaled by the reveal fade below). Stops the selected tab's
        -- whisper flash (ref FCF_SelectDockFrame → UIFrameFlashRemoveFrame). Tab getglobals are
        -- guarded: window 2's tab is deliberately unbuilt (see the note at the tab section).
        function BenillaFCF_SelectDock(id)
            BenillaFCF.selected = id
            for i = 1, 2 do
                local frame = getglobal("ChatFrame" .. i)
                if i == id then frame:Show() else frame:Hide() end
            end
            if BenillaFCF.flashTab == id then
                BenillaFCF.flashTab = 0
                local flash = getglobal("ChatFrame" .. id .. "TabFlash")
                if flash then flash:Hide() end
            end
        end

        function BenillaFCF_TabClick(id)
            -- ref FCF_Tab_OnClick (docked, left click): select; UChatScrollButton per click.
            BenillaFCF_SelectDock(id)
            PlaySound("UChatScrollButton")
        end

        -- The whisper tab flash (ref FCF_FlashTab: never the selected tab; 0.25s on/off for 60s,
        -- and a flashing tab holds the dock tabs visible). Fired by the app on a received
        -- whisper landing in an unselected window (0288 P4). No-tab windows can't flash.
        function BenillaFCF_FlashTab(id)
            if id == BenillaFCF.selected then return end
            if not getglobal("ChatFrame" .. id .. "TabFlash") then return end
            BenillaFCF.flashTab = id
            BenillaFCF.flashLeft = 60
        end

        -- PanelTemplates_TabResize(5, tab), transcribed: the ref sizes every docked tab to its
        -- label (FCF_DockUpdate) — middle slice = text width + 5, tab = middle + the two 16px
        -- caps; the flash/highlight bands follow the Left/Right pieces by anchor. The label
        -- width is host-measured (GetStringWidth), so early frames may see 0 — the OnUpdate
        -- below re-applies until it settles, then the change-guard makes this a no-op.
        function BenillaFCF_TabResize(tab)
            local w = getglobal(tab:GetName() .. "Text"):GetStringWidth()
            if w == 0 or tab.benillaTabTextW == w then return end
            tab.benillaTabTextW = w
            getglobal(tab:GetName() .. "Middle"):SetWidth(w + 5)
            tab:SetWidth(w + 5 + 32)
        end

        -- The hover rect: the dock's rect expanded by the ref's MouseIsOver pads
        -- (FCF_OnUpdate: MouseIsOver(chatFrame, 45, -10, -5, 5) — 45 up into the tab zone,
        -- 10 down past the edit box seam, 5 out each side).
        local function overDock(x, y)
            local f = ChatFrame1
            local left, right = f:GetLeft(), f:GetRight()
            local top, bottom = f:GetTop(), f:GetBottom()
            if not left then return false end
            return x >= left - 5 and x <= right + 5 and y >= bottom - 10 and y <= top + 45
        end

        -- FCF_OnUpdate transcription (the parts that survive with window management out):
        -- reveal after a 0.2s STATIONARY hover (a moving cursor keeps resetting the delay),
        -- fade over 0.15s, conceal on leave; a flashing tab forces the tabs visible; the
        -- selected window's textures ride the same fade toward alpha 0.25 (the chat-cache
        -- default window alpha is 0 — the box only exists on hover).
        function BenillaFCF_OnUpdate(elapsed)
            local s = BenillaFCF
            local x, y = GetCursorPosition()
            if overDock(x, y) then
                if not s.hover then
                    s.hover = true
                    s.hoverTime = 0
                    s.oldX, s.oldY = x, y
                elseif s.oldX == x and s.oldY == y then
                    s.hoverTime = s.hoverTime + elapsed
                else
                    s.hoverTime = 0
                    s.oldX, s.oldY = x, y
                end
                if s.hoverTime > 0.2 then s.revealTarget = 1 end
            else
                s.hover = false
                s.hoverTime = 0
                s.revealTarget = 0
            end
            if s.flashTab ~= 0 then s.revealTarget = 1 end

            -- The 0.15s linear fade toward the target (ref UIFrameFadeIn/Out over
            -- CHAT_FRAME_FADE_TIME).
            if s.reveal < s.revealTarget then
                s.reveal = math.min(s.revealTarget, s.reveal + elapsed / 0.15)
            elseif s.reveal > s.revealTarget then
                s.reveal = math.max(s.revealTarget, s.reveal - elapsed / 0.15)
            end

            -- Apply: tabs at 1.0 (selected) / 0.5 (unselected) × reveal; the selected window's
            -- background+borders at 0.25 × reveal (ref: fade oldAlpha↔DEFAULT_CHATFRAME_ALPHA).
            for i = 1, 2 do
                local tab = getglobal("ChatFrame" .. i .. "Tab")
                if tab then
                    local a = (i == BenillaFCF.selected) and 1.0 or 0.5
                    tab:SetAlpha(a * s.reveal)
                    BenillaFCF_TabResize(tab)
                end
                for _, t in ipairs(BenillaFCF_Textures(i)) do
                    t:SetAlpha(0.25 * s.reveal)
                end
            end

            -- The whisper flash blink (0.25 on / 0.25 off, 60s — ref UIFrameFlash args).
            if s.flashTab ~= 0 then
                s.flashLeft = s.flashLeft - elapsed
                local flash = getglobal("ChatFrame" .. s.flashTab .. "TabFlash")
                if s.flashLeft <= 0 then
                    s.flashTab = 0
                    flash:Hide()
                else
                    local phase = mod(s.flashLeft, 0.5)
                    if phase > 0.25 then flash:Show() else flash:Hide() end
                end
            end
        end

        -- ChatFrame_OnUpdate transcription: the bottom button's blink while scrolled up
        -- (CHAT_BUTTON_FLASH_TIME = 0.5s toggle; hidden the moment the view is AtBottom).
        function BenillaChatFrame_OnUpdate(frame, elapsed)
            local flash = getglobal(frame:GetName() .. "BottomButtonFlash")
            if not flash then return end
            if frame:AtBottom() then
                flash:Hide()
                frame.flashTimer = 0
                return
            end
            frame.flashTimer = (frame.flashTimer or 0) + elapsed
            while frame.flashTimer >= 0.5 do
                frame.flashTimer = frame.flashTimer - 0.5
                if flash:IsVisible() then flash:Hide() else flash:Show() end
            end
        end

        -- A completed left click on the chat body dismisses a held SPELL/ACTION payload
        -- (decision 0843, the director's call — no ref counterpart: the reference keeps a
        -- non-item payload on any frame click). Items are deliberately excluded: an item
        -- dismissal is a destroy, which only the world-drop popup flow may offer.
        function BenillaChatFrame_DismissCursor(button)
            if button ~= "LeftButton" then return end
            local kind = GetCursorInfo()
            if kind == "spell" or kind == "action" then
                ClearCursor()
            end
        end

        -- MessageFrameScrollButton_OnLoad/_OnUpdate + the ref OnClick pair: a press arms the
        -- hold-repeat (initial delay 0), each 0.05s while held scrolls WITHOUT the sound; the
        -- release click scrolls once WITH the sound (ref FloatingChatFrame.xml's DownButton/
        -- UpButton scripts — sound only on the non-pushed branch).
        function BenillaChatScrollButton_OnClick(btn, down, dir, sound)
            if down then
                btn.clickDelay = 0
            else
                PlaySound(sound)
                local frame = getglobal("ChatFrame" .. BenillaFCF.selected)
                if dir == "up" then frame:ScrollUp() else frame:ScrollDown() end
            end
        end

        function BenillaChatScrollButton_OnUpdate(btn, elapsed, dir)
            if btn:GetButtonState() == "PUSHED" then
                btn.clickDelay = (btn.clickDelay or 0) - elapsed
                if btn.clickDelay < 0 then
                    local frame = getglobal("ChatFrame" .. BenillaFCF.selected)
                    if dir == "up" then frame:ScrollUp() else frame:ScrollDown() end
                    btn.clickDelay = 0.05
                end
            end
        end

        -- ── BenillaUIMenu: the 1.12 UIMenu kit, transcribed (ref UIMenu.lua — the chat menu's
        -- row engine: fixed 16px rows in a tooltip-backdrop box, a 2 s no-hover timeout that
        -- walks up parentMenu chains, nested submenus opened on row hover). Constants quoted.
        -- Scoped here because the chat menu is its only consumer; a second consumer graduates
        -- it to its own file.
        BENILLA_UIMENU_BUTTON_HEIGHT = 16
        BENILLA_UIMENU_BUTTON_WIDTH = 104
        BENILLA_UIMENU_BORDER_HEIGHT = 12
        BENILLA_UIMENU_BORDER_WIDTH = 12
        BENILLA_UIMENU_NUMBUTTONS = 32
        BENILLA_UIMENU_TIMEOUT = 2.0

        function BenillaUIMenu_Initialize(menu)
            menu.numButtons = 0
            menu.subMenu = ""
            local name = menu:GetName()
            for i = 1, BENILLA_UIMENU_NUMBUTTONS do
                local button = getglobal(name .. "Button" .. i)
                button:SetWidth(BENILLA_UIMENU_BUTTON_WIDTH)
                button:SetHeight(BENILLA_UIMENU_BUTTON_HEIGHT)
                button:Hide()
                getglobal(button:GetName() .. "ShortcutText"):Hide()
            end
            menu:SetWidth(BENILLA_UIMENU_BUTTON_WIDTH + BENILLA_UIMENU_BORDER_WIDTH * 2)
            menu:SetHeight(BENILLA_UIMENU_BORDER_HEIGHT * 2)
        end

        -- Rows past the button pool are dropped (the ref message()s; nothing we author overflows).
        function BenillaUIMenu_AddButton(menu, text, shortcut, func, nested)
            local id = menu.numButtons + 1
            if id > BENILLA_UIMENU_NUMBUTTONS then return end
            menu.numButtons = id
            local button = getglobal(menu:GetName() .. "Button" .. id)
            if text then button:SetText(text) end
            button.func = func
            button.nested = nested
            button:Show()
            if shortcut then
                local s = getglobal(button:GetName() .. "ShortcutText")
                s:SetText(shortcut)
                s:Show()
            end
            menu:SetHeight(id * BENILLA_UIMENU_BUTTON_HEIGHT + BENILLA_UIMENU_BORDER_HEIGHT * 2)
        end

        function BenillaUIMenu_OnShow()
            this.timeleft = BENILLA_UIMENU_TIMEOUT
            this.counting = 1
        end

        function BenillaUIMenu_OnUpdate(elapsed)
            if this.counting == 1 then
                local timeleft = (this.timeleft or BENILLA_UIMENU_TIMEOUT) - elapsed
                if timeleft <= 0 then
                    this:Hide()
                    return
                end
                this.timeleft = timeleft
            end
        end

        function BenillaUIMenu_StartCounting(menu)
            menu.counting = 1
            if menu.parentMenu then BenillaUIMenu_StartCounting(getglobal(menu.parentMenu)) end
        end

        function BenillaUIMenu_StopCounting(menu)
            menu.counting = 0
            menu.timeleft = BENILLA_UIMENU_TIMEOUT
            if menu.parentMenu then BenillaUIMenu_StopCounting(getglobal(menu.parentMenu)) end
        end

        function BenillaUIMenuButton_OnLoad()
            this:SetPoint("TOP", this:GetParent():GetName(), "TOP", 0,
                -((this:GetID() - 1) * BENILLA_UIMENU_BUTTON_HEIGHT) - BENILLA_UIMENU_BORDER_HEIGHT)
        end

        function BenillaUIMenuButton_OnClick()
            if this.func then this.func() end
            this:GetParent():Hide()
            PlaySound("UChatScrollButton")
        end

        function BenillaUIMenuButton_OnEnter()
            local nested = this.nested
            if nested then
                local menu = getglobal(nested)
                if not menu:IsVisible() then
                    local oldMenu = getglobal(this:GetParent().subMenu or "")
                    if oldMenu then oldMenu:Hide() end
                    this:GetParent().subMenu = nested
                    menu:SetPoint("BOTTOMLEFT", this:GetName(), "BOTTOMRIGHT", 10, -12)
                    menu:Show()
                end
                BenillaUIMenu_StopCounting(menu)
            else
                BenillaUIMenu_StopCounting(this:GetParent())
            end
        end

        function BenillaUIMenuButton_OnLeave()
            BenillaUIMenu_StartCounting(this:GetParent())
            if this.nested then BenillaUIMenu_StartCounting(getglobal(this.nested)) end
        end

        -- ── The chat menu rows (ref ChatMenu_* in ChatFrame.lua, adapted): every type row
        -- prefixes the box with the type's slash and lets the LIVE PARSE convert — the ref's
        -- own Whisper row does literally `SetText("/w "..GetText())`, and routing all rows the
        -- same way means the menu can never drift from the slash grammar the edit machine
        -- owns. Labels/shortcuts quoted from GlobalStrings. Language (benilla has no language
        -- model yet) and Macro (no macro frame) are deliberately out; this OnLoad is their
        -- return path.
        function BenillaChatMenu_Type(prefix)
            local eb = ChatFrameEditBox
            eb:Show()
            eb:SetFocus()
            eb:SetText(prefix .. (eb:GetText() or ""))
        end

        function BenillaChatMenu_OnLoad()
            BenillaUIMenu_Initialize(this)
            BenillaUIMenu_AddButton(this, "Say", "/s", function() BenillaChatMenu_Type("/s ") end)
            BenillaUIMenu_AddButton(this, "Party Chat", "/p", function() BenillaChatMenu_Type("/p ") end)
            BenillaUIMenu_AddButton(this, "Guild Chat", "/g", function() BenillaChatMenu_Type("/g ") end)
            BenillaUIMenu_AddButton(this, "Yell", "/y", function() BenillaChatMenu_Type("/y ") end)
            BenillaUIMenu_AddButton(this, "Whisper", "/w", function() BenillaChatMenu_Type("/w ") end)
            BenillaUIMenu_AddButton(this, "Emote", "/e", function() BenillaChatMenu_Type("/e ") end, "EmoteMenu")
            BenillaUIMenu_AddButton(this, "Reply", "/r", function() BenillaChatMenu_Type("/r ") end)
            BenillaUIMenu_AddButton(this, "Voice Emote", nil, nil, "VoiceMacroMenu")
        end

        -- An emote row submits its /command through the REAL chat pipeline (SubmitChatInput →
        -- the router's EmotesText resolve + the send-side posture gate) — the ref's DoEmote by
        -- token, reached through our one grammar. The lists are the ref's EmoteList /
        -- TextEmoteSpeechList tokens as OUR canonical /commands (the EmotesText names the typed
        -- grammar resolves), CMD1-sorted like the ref menu. Three ref labels differ
        -- (/attacktarget /followme /silly are GlobalStrings CMD aliases the typed grammar
        -- doesn't carry yet) — each row shows the command it actually runs.
        BenillaEmoteMenuList = {
            "/applaud", "/beg", "/bow", "/chicken", "/cry", "/dance", "/eat", "/flex",
            "/kiss", "/kneel", "/laugh", "/point", "/roar", "/rude", "/salute", "/shy",
            "/sit", "/sleep", "/stand", "/talk", "/wave",
        }
        BenillaVoiceMacroList = {
            "/attackmytarget", "/bye", "/charge", "/cheer", "/congratulate", "/flee",
            "/flirt", "/follow", "/healme", "/hello", "/helpme", "/incoming", "/joke",
            "/no", "/nod", "/oom", "/openfire", "/rasp", "/thank", "/train", "/wait",
            "/welcome",
        }

        function BenillaEmoteMenu_Click(cmd)
            SubmitChatInput(cmd)
            ChatMenu:Hide()
        end

        function BenillaOnEmoteMenuLoad(list)
            BenillaUIMenu_Initialize(this)
            this.parentMenu = "ChatMenu"
            for _, cmd in ipairs(list) do
                local c = cmd
                BenillaUIMenu_AddButton(this, cmd, nil, function() BenillaEmoteMenu_Click(c) end)
            end
        end
    ]]></Script>

    <!-- ── The dock: ChatFrame1 (General) + ChatFrame2 (Combat Log) sharing its rect ─────── -->
    <!--
        ChatFrame1: 430×120 at BOTTOMLEFT (32, 85) — the managed-position base
        (UIPARENT_MANAGED_FRAME_POSITIONS["ChatFrame1"]: baseY 85 + the bottom-stack offsets,
        applied by UIParent_ManageFramePositions per decision 0272); displayDuration 120 /
        maxLines 128 (ref ChatFrameTemplate). The background stretches -2/+2 x and +3/-6 y past
        the frame (ref $parentBackground anchors), the 8 border slices ring it (the ref draws
        them through its resize buttons' textures; benilla authors them as plain textures — the
        hover LOOK without the resize mechanics). Everything starts alpha 0; BenillaFCF fades.
    -->
    <ScrollingMessageFrame name="ChatFrame1" frameStrata="BACKGROUND" displayDuration="120.0" maxLines="128">
        <Size><AbsDimension x="430" y="120"/></Size>
        <Anchors>
            <Anchor point="BOTTOMLEFT" relativePoint="BOTTOMLEFT">
                <Offset><AbsDimension x="32" y="85"/></Offset>
            </Anchor>
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentBackground" file="Interface\ChatFrame\ChatFrameBackground" alpha="0">
                    <Anchors>
                        <Anchor point="TOPLEFT"><Offset><AbsDimension x="-2" y="3"/></Offset></Anchor>
                        <Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="2" y="-6"/></Offset></Anchor>
                    </Anchors>
                </Texture>
                <!-- The ChatFrameBorder ring (ref ChatFrameBorder slices; texcoords quoted from
                     the ref resize buttons). Corners 16×16, edges stretched between them. -->
                <Texture name="$parentBorderTopLeft" file="Interface\ChatFrame\ChatFrameBorder" alpha="0">
                    <Size><AbsDimension x="16" y="16"/></Size>
                    <Anchors><Anchor point="TOPLEFT" relativeTo="$parentBackground"><Offset><AbsDimension x="-2" y="2"/></Offset></Anchor></Anchors>
                    <TexCoords left="0" right="0.25" top="0" bottom="0.125"/>
                </Texture>
                <Texture name="$parentBorderTopRight" file="Interface\ChatFrame\ChatFrameBorder" alpha="0">
                    <Size><AbsDimension x="16" y="16"/></Size>
                    <Anchors><Anchor point="TOPRIGHT" relativeTo="$parentBackground"><Offset><AbsDimension x="2" y="2"/></Offset></Anchor></Anchors>
                    <TexCoords left="0.75" right="1.0" top="0" bottom="0.125"/>
                </Texture>
                <Texture name="$parentBorderBottomLeft" file="Interface\ChatFrame\ChatFrameBorder" alpha="0">
                    <Size><AbsDimension x="16" y="16"/></Size>
                    <Anchors><Anchor point="BOTTOMLEFT" relativeTo="$parentBackground"><Offset><AbsDimension x="-2" y="-3"/></Offset></Anchor></Anchors>
                    <TexCoords left="0" right="0.25" top="0.7265625" bottom="0.8515625"/>
                </Texture>
                <Texture name="$parentBorderBottomRight" file="Interface\ChatFrame\ChatFrameBorder" alpha="0">
                    <Size><AbsDimension x="16" y="16"/></Size>
                    <Anchors><Anchor point="BOTTOMRIGHT" relativeTo="$parentBackground"><Offset><AbsDimension x="2" y="-3"/></Offset></Anchor></Anchors>
                    <TexCoords left="0.75" right="1.0" top="0.7265625" bottom="0.8515625"/>
                </Texture>
                <Texture name="$parentBorderTop" file="Interface\ChatFrame\ChatFrameBorder" alpha="0">
                    <Size><AbsDimension x="16" y="16"/></Size>
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentBorderTopLeft" relativePoint="RIGHT"/>
                        <Anchor point="RIGHT" relativeTo="$parentBorderTopRight" relativePoint="LEFT"/>
                    </Anchors>
                    <TexCoords left="0.25" right="0.75" top="0" bottom="0.125"/>
                </Texture>
                <Texture name="$parentBorderBottom" file="Interface\ChatFrame\ChatFrameBorder" alpha="0">
                    <Size><AbsDimension x="16" y="16"/></Size>
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentBorderBottomLeft" relativePoint="RIGHT"/>
                        <Anchor point="RIGHT" relativeTo="$parentBorderBottomRight" relativePoint="LEFT"/>
                    </Anchors>
                    <TexCoords left="0.25" right="0.75" top="0.7265625" bottom="0.8515625"/>
                </Texture>
                <Texture name="$parentBorderLeft" file="Interface\ChatFrame\ChatFrameBorder" alpha="0">
                    <Size><AbsDimension x="16" y="16"/></Size>
                    <Anchors>
                        <Anchor point="TOP" relativeTo="$parentBorderTopLeft" relativePoint="BOTTOM"/>
                        <Anchor point="BOTTOM" relativeTo="$parentBorderBottomLeft" relativePoint="TOP"/>
                    </Anchors>
                    <TexCoords left="0" right="0.25" top="0.125" bottom="0.7265625"/>
                </Texture>
                <Texture name="$parentBorderRight" file="Interface\ChatFrame\ChatFrameBorder" alpha="0">
                    <Size><AbsDimension x="16" y="16"/></Size>
                    <Anchors>
                        <Anchor point="TOP" relativeTo="$parentBorderTopRight" relativePoint="BOTTOM"/>
                        <Anchor point="BOTTOM" relativeTo="$parentBorderBottomRight" relativePoint="TOP"/>
                    </Anchors>
                    <TexCoords left="0.75" right="1.0" top="0.125" bottom="0.7265625"/>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <!-- The scroll column, outside bottom-left (ref: BottomButton at (-32,-4), Down and
                 Up stacked above it, 2px overlaps). Sounds + hold-repeat per the ref scripts. -->
            <Button name="$parentBottomButton">
                <Size><AbsDimension x="32" y="32"/></Size>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="-32" y="-4"/></Offset></Anchor>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <Texture name="$parentFlash" file="Interface\ChatFrame\UI-ChatIcon-BlinkHilight" hidden="true" setAllPoints="true"/>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnClick>
                        PlaySound("igChatBottom")
                        getglobal("ChatFrame" .. BenillaFCF.selected):ScrollToBottom()
                    </OnClick>
                </Scripts>
                <NormalTexture file="Interface\ChatFrame\UI-ChatIcon-ScrollEnd-Up"/>
                <PushedTexture file="Interface\ChatFrame\UI-ChatIcon-ScrollEnd-Down"/>
                <DisabledTexture file="Interface\ChatFrame\UI-ChatIcon-ScrollEnd-Disabled"/>
                <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
            </Button>
            <Button name="$parentDownButton">
                <Size><AbsDimension x="32" y="32"/></Size>
                <Anchors>
                    <Anchor point="BOTTOM" relativeTo="$parentBottomButton" relativePoint="TOP"><Offset><AbsDimension x="0" y="-2"/></Offset></Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        <!-- All four transitions, ref-verbatim (MessageFrameScrollButton_OnLoad,
                             ChatFrame.lua:1583): the OnClick body reads no button, so a right-click
                             scrolls exactly like a left one, and the DOWN halves are what arm the
                             hold-repeat. -->
                        this:RegisterForClicks("LeftButtonDown", "LeftButtonUp", "RightButtonUp", "RightButtonDown")
                    </OnLoad>
                    <OnClick>
                        BenillaChatScrollButton_OnClick(this, arg2, "down", "igChatScrollDown")
                    </OnClick>
                    <OnUpdate>
                        BenillaChatScrollButton_OnUpdate(this, arg1, "down")
                    </OnUpdate>
                </Scripts>
                <NormalTexture file="Interface\ChatFrame\UI-ChatIcon-ScrollDown-Up"/>
                <PushedTexture file="Interface\ChatFrame\UI-ChatIcon-ScrollDown-Down"/>
                <DisabledTexture file="Interface\ChatFrame\UI-ChatIcon-ScrollDown-Disabled"/>
                <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
            </Button>
            <Button name="$parentUpButton">
                <Size><AbsDimension x="32" y="32"/></Size>
                <Anchors>
                    <Anchor point="BOTTOM" relativeTo="$parentDownButton" relativePoint="TOP"/>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        <!-- All four, ref-verbatim — see the down button's note. -->
                        this:RegisterForClicks("LeftButtonDown", "LeftButtonUp", "RightButtonUp", "RightButtonDown")
                    </OnLoad>
                    <OnClick>
                        BenillaChatScrollButton_OnClick(this, arg2, "up", "igChatScrollUp")
                    </OnClick>
                    <OnUpdate>
                        BenillaChatScrollButton_OnUpdate(this, arg1, "up")
                    </OnUpdate>
                </Scripts>
                <NormalTexture file="Interface\ChatFrame\UI-ChatIcon-ScrollUp-Up"/>
                <PushedTexture file="Interface\ChatFrame\UI-ChatIcon-ScrollUp-Down"/>
                <DisabledTexture file="Interface\ChatFrame\UI-ChatIcon-ScrollUp-Disabled"/>
                <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
            </Button>
        </Frames>
        <Scripts>
            <!-- EXECUTE_CHAT_LINE — how a MACRO line reaches the chat grammar (0996, wow-re
                 `macro-execution-law.md` §4, VERIFIED). The engine's macro runner (`0x4f14e0`)
                 names no Lua function and walks no command table: per body line it fires
                 `FrameScript_SignalEvent(0x188, "%s", line)`, and `0x188` is EXECUTE_CHAT_LINE
                 (the registry slot `0xbe17b8` is written once, at `0x51b4ff`, with `0x852470`).
                 ChatFrame.lua:1343 is the handler — `editBox:SetText(arg1)` → `ChatEdit_SendText`
                 → `ChatEdit_OnEscapePressed` — and ChatFrame1's OnLoad
                 (FloatingChatFrame.xml:700) is its ONLY registrant in the whole default UI, so
                 every macro line runs through THIS frame's box whichever one has focus. benilla's
                 SubmitChatInput stands in for ChatEdit_SendText: the grammar behind it is Rust
                 (0881), which is the only part of that chain we replace. -->
            <OnLoad>
                this:RegisterEvent("EXECUTE_CHAT_LINE")
            </OnLoad>
            <OnEvent>
                if event == "EXECUTE_CHAT_LINE" then SubmitChatInput(arg1) end
            </OnEvent>
            <OnUpdate>
                BenillaFCF_OnUpdate(arg1)
                BenillaChatFrame_OnUpdate(this, arg1)
            </OnUpdate>
            <OnMouseWheel>
                -- WoW wheel convention: +1 per notch up, -1 down. Up = older messages.
                if arg1 > 0 then this:ScrollUp() else this:ScrollDown() end
            </OnMouseWheel>
            <OnClick>
                BenillaChatFrame_DismissCursor(arg1)
            </OnClick>
            <OnHyperlinkClick>
                SetItemRef(arg1, arg2, arg3)
            </OnHyperlinkClick>
        </Scripts>
        <FontString inherits="ChatFontNormal" justifyH="LEFT"/>
    </ScrollingMessageFrame>

    <!-- ChatFrame2 "Combat Log": docked — shares ChatFrame1's rect (ref FCF_DockUpdate anchors),
