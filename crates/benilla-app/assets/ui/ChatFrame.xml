    <!-- ── The edit box (ref ChatFrameEditBox): below ChatFrame1, -5/+5 wide, 32 tall, DIALOG
         strata, hidden until ENTER opens it (ui_chat::input). The three-piece
         UI-ChatInputBorder art; the header ("Say:" until the P5 edit machine drives it) at
         LEFT+13; typed text starts past it (static insets, P5 makes them live). ─────────── -->
    <!-- The ref template ships ignoreArrows="true": plain arrows fall through to CHARACTER
         MOVEMENT while typing (Ctrl bypasses), because 1.12 lets you keep arrow-steering with
         the box open. benilla has no typing-while-moving arrow scheme, so the attr would leave
         the keys dead; the director's call is the modern law — plain arrows move the caret,
         Up/Down recall history (decision 0301). The engine still honors the attr faithfully
         for any box that sets it. -->
    <!-- historyLines: the ref template ships 32; 64 at the director's call ("at least 50",
         2026-07-26) — the recall walk is the modern law already (decision 0301). -->
    <EditBox name="ChatFrameEditBox" frameStrata="DIALOG" hidden="true" historyLines="64" letters="255">
        <Size><AbsDimension x="0" y="32"/></Size>
        <Anchors>
