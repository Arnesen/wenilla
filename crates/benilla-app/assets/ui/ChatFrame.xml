                <FontString name="$parentHeader" inherits="ChatFontNormal" text="Say:">
                    <Anchors>
                        <Anchor point="LEFT"><Offset><AbsDimension x="13" y="0"/></Offset></Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnEnterPressed>
                SubmitChatInput(this:GetText())
                this:SetText("")
                this:ClearFocus()
                this:Hide()
            </OnEnterPressed>
            <OnEscapePressed>
                this:SetText("")
                this:ClearFocus()
                this:Hide()
            </OnEscapePressed>
            <OnTabPressed>
                BenillaChatTabPressed()
            </OnTabPressed>
        </Scripts>
        <FontString inherits="ChatFontNormal" justifyH="LEFT"/>
    </EditBox>

    <!-- The load-order hack, like the ref's own trailing FCF_DockFrame(ChatFrame1, 1): select
         the General tab once everything above exists — and tint the window chrome BLACK
         (FCF_SetWindowColor: the ref vertex-colors every CHAT_FRAME_TEXTURES piece with the
         chat-cache window COLOR, which ships 0 0 0; the ChatFrameBackground art itself is
         white, so untinted it reads as a white wash over the world). -->
    <Script><![CDATA[
        BenillaFCF_SelectDock(1)
        for i = 1, 2 do
            for _, t in ipairs(BenillaFCF_Textures(i)) do
                t:SetVertexColor(0, 0, 0)
            end
        end
    ]]></Script>
</Ui>
