    <!-- ChatMenu + its two nested menus (ref FloatingChatFrame.xml; the ref's own OnShow
         hides only EmoteMenu — hiding both submenus is the same intent without the ref's
         Voice-menu-left-open corner). The submenus are authored as children (the ref's
         parent="ChatMenu" attr — this engine attaches by nesting, CharacterFrame.xml's note),
         so hiding ChatMenu hides them with it. -->
    <Frame name="ChatMenu" inherits="UIMenuTemplate" hidden="true">
        <Anchors>
            <Anchor point="BOTTOMLEFT" relativeTo="ChatFrameMenuButton" relativePoint="TOPRIGHT"/>
        </Anchors>
