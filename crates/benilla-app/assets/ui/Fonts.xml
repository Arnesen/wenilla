    <!-- CombatTextFont: FRIZQT 25, gold, MasterFont shadow (ref l.305). -->
    <Font name="CombatTextFont" inherits="MasterFont" font="Fonts\FRIZQT__.TTF" virtual="true">
        <FontHeight><AbsValue val="25"/></FontHeight>
        <Color r="1.0" g="0.82" b="0"/>
    </Font>
</Ui>
