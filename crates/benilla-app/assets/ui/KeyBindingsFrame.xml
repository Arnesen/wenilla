                 with 1.12's own confirm-on-unsaved-changes law and tooltip. -->
            <CheckButton name="$parentCharacterButton">
                <Size><AbsDimension x="20" y="20"/></Size>
                <Anchors><Anchor point="TOPLEFT" relativePoint="TOPRIGHT"><Offset><AbsDimension x="-260" y="-24"/></Offset></Anchor></Anchors>
