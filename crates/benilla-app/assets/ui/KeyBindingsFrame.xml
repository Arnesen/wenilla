    <Script><![CDATA[
        -- ── Strings ── the 1.12 GlobalStrings globals, each with the raw fallback (a headless
        -- harness without GlobalStrings still works; the era's own `_G[x] or x` posture).
        function KeyBindings_String(name, fallback)
            local s = getglobal(name)
            if s then return s end
            return fallback
        end

        -- ── The category model (era KeyBindingFrame_LoadCategories, simplified by the honest
        -- tree): walk GetBinding(i), group runs of one category token; order = first
        -- appearance, which IS 1.12's Bindings.xml order (the registry registers in it).
        -- Rebuilt on every show, not load: the app seeds the table at PostStartup, after this
        -- file's OnLoads ran.
        function KeyBindings_LoadCategories()
            local frame = KeyBindingFrame
            frame.categories = {}
            local byToken = {}
            for i = 1, GetNumBindings() do
                local _, category = GetBinding(i)
                local cat = byToken[category]
                if not cat then
                    cat = { token = category, indices = {} }
                    byToken[category] = cat
                    table.insert(frame.categories, cat)
                end
                table.insert(cat.indices, i)
            end
            for n = 1, 12 do
                local row = getglobal("KeyBindingFrameCategory" .. n)
                local cat = frame.categories[n]
                if cat then
                    row.categoryIndex = n
                    row:SetText(KeyBindings_String(cat.token, cat.token))
                    row:Show()
                else
                    row:Hide()
                end
            end
            if not frame.categories[frame.selectedCategory or 0] then
                frame.selectedCategory = 1
            end
            KeyBindings_PaintCategories()
        end

        -- The selection paint (the options window's gold-lock / blue-hover law).
        function KeyBindings_PaintCategories()
            for n = 1, 12 do
                local bg = getglobal("KeyBindingFrameCategory" .. n .. "Bg")
                if n == KeyBindingFrame.selectedCategory then
                    bg:SetVertexColor(1, 1, 0)
                    bg:Show()
                else
                    bg:Hide()
                end
            end
        end

        function KeyBindingsCategory_OnClick(row)
            PlaySound("igMainMenuOptionCheckBoxOn")
            KeyBindingFrame.selectedCategory = row.categoryIndex
            KeyBindings_SetSelected(nil)
            KeyBindingFrameOutputText:SetText("")
            KeyBindings_PaintCategories()
            KeyBindingFrameScrollFrameScrollBar:SetValue(0)
            KeyBindingFrame_Update()
        end

        -- ── Key display ── the 1.12 GetBindingText law by hand: modifier prefixes stay the
        -- canonical uppercase tokens, the base key reads its KEY_* global (Spacebar, Up Arrow,
        -- Mouse Button 4...) else itself. "CTRL--" renders CTRL + the minus key.
        function KeyBindings_KeyText(key)
            if not key then
                return NORMAL_FONT_COLOR_CODE .. KeyBindings_String("NOT_BOUND", "Not Bound") .. FONT_COLOR_CODE_CLOSE
            end
            local prefix = ""
            local rest = key
            while true do
                local p = string.sub(rest, 1, 4)
                if p == "ALT-" then
                    prefix = prefix .. "ALT-"
                    rest = string.sub(rest, 5)
                elseif string.sub(rest, 1, 5) == "CTRL-" then
                    prefix = prefix .. "CTRL-"
                    rest = string.sub(rest, 6)
                elseif string.sub(rest, 1, 6) == "SHIFT-" then
                    prefix = prefix .. "SHIFT-"
                    rest = string.sub(rest, 7)
                else
                    break
                end
            end
            return prefix .. KeyBindings_String("KEY_" .. rest, rest)
        end

        -- ── The list repaint (1.12 KeyBindingFrame_Update over the era category page). -->
        KEY_BINDINGS_DISPLAYED = 20
        KEY_BINDING_HEIGHT = 25

        function KeyBindingFrame_Update()
            local frame = KeyBindingFrame
            local cat = frame.categories and frame.categories[frame.selectedCategory]
            local indices = cat and cat.indices or {}
            local numBindings = table.getn(indices)
            local offset = BenillaFauxScrollFrame_GetOffset(KeyBindingFrameScrollFrame)
            for i = 1, KEY_BINDINGS_DISPLAYED do
                local row = getglobal("KeyBindingFrameBinding" .. i)
                local index = indices[offset + i]
                if index then
                    local command, _, key1, key2 = GetBinding(index)
                    local b1 = getglobal("KeyBindingFrameBinding" .. i .. "Key1Button")
                    local b2 = getglobal("KeyBindingFrameBinding" .. i .. "Key2Button")
                    b1.commandName = command
                    b2.commandName = command
                    b1:SetText(KeyBindings_KeyText(key1))
                    b2:SetText(KeyBindings_KeyText(key2))
                    if key1 then b1:SetAlpha(1) else b1:SetAlpha(0.8) end
                    if key2 then b2:SetAlpha(1) else b2:SetAlpha(0.8) end
                    getglobal("KeyBindingFrameBinding" .. i .. "Description"):SetText(
                        KeyBindings_String("BINDING_NAME_" .. command, command))
                    -- The 1.12 selection highlight: the pressed capsule holds its glow.
                    if frame.selected == command and frame.keyID == 1 then
                        b1:LockHighlight()
                    else
                        b1:UnlockHighlight()
                    end
                    if frame.selected == command and frame.keyID == 2 then
                        b2:LockHighlight()
                    else
                        b2:UnlockHighlight()
                    end
                    row:Show()
                else
                    row:Hide()
                end
            end
            BenillaFauxScrollFrame_Update(KeyBindingFrameScrollFrame, numBindings,
                KEY_BINDINGS_DISPLAYED, KEY_BINDING_HEIGHT)
            KeyBindings_UpdateUnbindKey()
        end

        -- ── Selection + the capture arm ── selecting a capsule arms the HOST's capture seam
        -- (BenillaBindCapture): raw input is swallowed there and comes back canonical through
        -- KeyBindingFrame_OnHostKey. Deselecting (either way) disarms.
        function KeyBindings_SetSelected(command, keyID)
            KeyBindingFrame.selected = command
            KeyBindingFrame.keyID = keyID
            BenillaBindCapture(command ~= nil)
        end

        function KeyBindingButton_OnClick(button)
            -- The 1.12 law: while something is selected, only LEFT/RIGHT on a capsule
            -- re-select or deselect — a middle/4/5 press is a BIND, and the host's armed
            -- capture seam (which runs after this click) takes it, so this handler must not
            -- touch the selection for those buttons.
            if KeyBindingFrame.selected then
                if button ~= "LeftButton" and button ~= "RightButton" then
                    return
                end
                if KeyBindingFrame.selected == this.commandName and KeyBindingFrame.keyID == this:GetID() then
                    KeyBindings_SetSelected(nil)
                    KeyBindingFrameOutputText:SetText("")
                else
                    KeyBindings_SetSelected(this.commandName, this:GetID())
                    KeyBindingFrameOutputText:SetText(string.format(
                        KeyBindings_String("BIND_KEY_TO_COMMAND", "Press Key to Bind to Command -> %s"),
                        KeyBindings_String("BINDING_NAME_" .. this.commandName, this.commandName)))
                end
            else
                KeyBindings_SetSelected(this.commandName, this:GetID())
                KeyBindingFrameOutputText:SetText(string.format(
                    KeyBindings_String("BIND_KEY_TO_COMMAND", "Press Key to Bind to Command -> %s"),
                    KeyBindings_String("BINDING_NAME_" .. this.commandName, this.commandName)))
            end
            KeyBindingFrame_Update()
        end

        -- The host's capture callback: `chord` is canonical (ALT-CTRL-SHIFT-TOKEN). The body is
        -- 1.12's OnKeyDown selected-branch verbatim: steal message, clear the command's keys,
        -- rebind in slot order so the pressed slot takes the new chord.
        function KeyBindingFrame_OnHostKey(chord)
            local frame = KeyBindingFrame
            if not frame.selected then
                return
            end
            local selected = frame.selected
            local oldAction = GetBindingAction(chord)
            if oldAction ~= "" and oldAction ~= selected then
                local k1, k2 = GetBindingKey(oldAction)
                if (not k1 or k1 == chord) and (not k2 or k2 == chord) then
                    KeyBindingFrameOutputText:SetText(string.format(
                        KeyBindings_String("KEY_UNBOUND_ERROR", "|cffff0000%s Function is Now Unbound!|r"),
                        KeyBindings_String("BINDING_NAME_" .. oldAction, oldAction)))
                else
                    KeyBindingFrameOutputText:SetText(KeyBindings_String("KEY_BOUND", "Key Bound Successfully"))
                end
            else
                KeyBindingFrameOutputText:SetText(KeyBindings_String("KEY_BOUND", "Key Bound Successfully"))
            end
            local key1, key2 = GetBindingKey(selected)
            if key1 then SetBinding(key1) end
            if key2 then SetBinding(key2) end
            if frame.keyID == 1 then
                KeyBindings_SetOrRestore(chord, selected, key1)
                if key2 then SetBinding(key2, selected) end
            else
                if key1 then SetBinding(key1, selected) end
                KeyBindings_SetOrRestore(chord, selected, key2)
            end
            frame.bindingsChanged = 1
            KeyBindings_SetSelected(nil)
            KeyBindingFrame_Update()
        end

        -- 1.12 KeyBindingFrame_SetBinding: a refused bind (the wheel on a press+release
        -- command) restores the slot's old key and says why.
        function KeyBindings_SetOrRestore(key, command, oldKey)
            if not SetBinding(key, command) then
                if oldKey then SetBinding(oldKey, command) end
                KeyBindingFrameOutputText:SetText(KeyBindings_String(
                    "KEYBINDINGFRAME_MOUSEWHEEL_ERROR",
                    "Can't bind mousewheel to actions with up and down states"))
            end
        end

        function KeyBindings_UpdateUnbindKey()
            if KeyBindingFrame.selected then
                KeyBindingFrameUnbindButton:Enable()
            else
                KeyBindingFrameUnbindButton:Disable()
            end
        end

        -- ── The bottom row + checkbox (1.12 bodies, era confirm on Reset To Default) ──
        function KeyBindings_Unbind()
            local frame = KeyBindingFrame
            local key1, key2 = GetBindingKey(frame.selected)
            if key1 then SetBinding(key1) end
            if key2 then SetBinding(key2) end
            if key1 and frame.keyID == 1 then
                if key2 then SetBinding(key2, frame.selected) end
            else
                if key1 then SetBinding(key1, frame.selected) end
            end
            frame.bindingsChanged = 1
            KeyBindings_SetSelected(nil)
            KeyBindingFrameOutputText:SetText("")
            KeyBindingFrame_Update()
        end

        function KeyBindings_UpdateHeader()
            if KeyBindingFrameCharacterButton:GetChecked() then
                KeyBindingFrameTitleText:SetText(string.format(
                    KeyBindings_String("CHARACTER_KEY_BINDINGS", "Key Bindings for %s"),
                    UnitName("player") or UNKNOWNOBJECT or "Unknown"))
            else
                KeyBindingFrameTitleText:SetText(KeyBindings_String("KEY_BINDINGS", "Key Bindings"))
            end
        end

        function KeyBindings_ChangeBindingProfile()
            if KeyBindingFrameCharacterButton:GetChecked() then
                LoadBindings(2)
            else
                LoadBindings(1)
            end
            KeyBindings_UpdateHeader()
            KeyBindingFrameOutputText:SetText("")
            KeyBindings_SetSelected(nil)
            KeyBindingFrame_Update()
        end

        function KeyBindings_Okay()
            local which
            if KeyBindingFrameCharacterButton:GetChecked() then
                which = 2
            else
                which = 1
                -- 1.12 guards on `GetCurrentBindingSet() == 2` here; in benilla's set model a
                -- character set EXISTS exactly while it is the active one (its file's presence
                -- IS the state — decision 0997), so the honest guard for "this Okay will
                -- permanently delete the character set" is existence, which also catches the
                -- uncheck-then-Okay path 1.12's literal guard let slip past its own warning.
                if BenillaCharacterBindingsExist() and not CONFIRMED_DELETING_CHARACTER_SPECIFIC_BINDINGS then
                    StaticPopup_Show("CONFIRM_DELETING_CHARACTER_SPECIFIC_BINDINGS")
                    return
                end
            end
            SaveBindings(which)
            KeyBindingFrameOutputText:SetText("")
            KeyBindings_SetSelected(nil)
            HideUIPanel(KeyBindingFrame)
        end

        -- Cancel / the ESC ladder's rung (UiPanels.xml): revert to the saved set and close.
        function KeyBindingFrame_Cancel()
            LoadBindings(GetCurrentBindingSet())
            KeyBindingFrameOutputText:SetText("")
            KeyBindings_SetSelected(nil)
            HideUIPanel(KeyBindingFrame)
        end

        StaticPopupDialogs["CONFIRM_DELETING_CHARACTER_SPECIFIC_BINDINGS"] = {
            text = KeyBindings_String("CONFIRM_DELETING_CHARACTER_SPECIFIC_BINDINGS",
                "Really switch to general key bindings?  All key bindings specific to this character will be permanantly deleted."),
            button1 = KeyBindings_String("OKAY", "Okay"),
            button2 = KeyBindings_String("CANCEL", "Cancel"),
            OnAccept = function()
                SaveBindings(1)
                KeyBindingFrameOutputText:SetText("")
                KeyBindings_SetSelected(nil)
                CONFIRMED_DELETING_CHARACTER_SPECIFIC_BINDINGS = 1
                HideUIPanel(KeyBindingFrame)
            end,
        }
        StaticPopupDialogs["CONFIRM_LOSE_BINDING_CHANGES"] = {
            text = KeyBindings_String("CONFIRM_LOSE_BINDING_CHANGES",
                "You will lose any unsaved changes if you switch between general and character specific key bindings."),
            button1 = KeyBindings_String("OKAY", "Okay"),
            button2 = KeyBindings_String("CANCEL", "Cancel"),
            OnAccept = function()
                KeyBindings_ChangeBindingProfile()
                KeyBindingFrame.bindingsChanged = nil
            end,
            OnCancel = function()
                if KeyBindingFrameCharacterButton:GetChecked() then
                    KeyBindingFrameCharacterButton:SetChecked(nil)
                else
                    KeyBindingFrameCharacterButton:SetChecked(1)
                end
            end,
        }
        -- Era addition kept (structure law): Reset To Default confirms first. 1.12 has no
        -- string for it; the literal is ours (the era's lives in its client binary).
        StaticPopupDialogs["CONFIRM_RESET_KEYBINDINGS"] = {
            text = "Are you sure you want to reset all keybindings to their defaults?",
            button1 = KeyBindings_String("OKAY", "Okay"),
            button2 = KeyBindings_String("CANCEL", "Cancel"),
            OnAccept = function()
                PlaySound("igMainMenuOptionCheckBoxOn")
                LoadBindings(0)
                KeyBindingFrameOutputText:SetText("")
                KeyBindings_SetSelected(nil)
                KeyBindingFrame_Update()
            end,
        }
    ]]></Script>

