                </Scripts>
            </Button>
            <Button name="$parentCancelButton" inherits="KeyBindingsRedButtonTemplate">
                <Anchors><Anchor point="BOTTOMLEFT" relativeTo="$parentOkayButton" relativePoint="BOTTOMRIGHT"/></Anchors>
                <Scripts>
                    <OnLoad>this:SetText(KeyBindings_String("CANCEL", "Cancel"))</OnLoad>
                    <OnClick>KeyBindingFrame_Cancel()</OnClick>
                </Scripts>
            </Button>
        </Frames>
        <Scripts>
            <OnShow>
                KeyBindings_LoadCategories()
                KeyBindingFrameCharacterButton:SetChecked(GetCurrentBindingSet() == 2 and 1 or nil)
                KeyBindings_UpdateHeader()
                KeyBindingFrame.bindingsChanged = nil
                KeyBindingFrameScrollFrameScrollBar:SetValue(0)
                KeyBindingFrame_Update()
            </OnShow>
            <OnHide>
                -- Both references reopen the game menu (1.12 + era OnHide); a straggling
                -- selection disarms the host capture seam.
                KeyBindings_SetSelected(nil)
                KeyBindingFrameOutputText:SetText("")
                ShowUIPanel(GameMenuFrame)
            </OnHide>
        </Scripts>
