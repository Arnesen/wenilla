                 same seam). The wheel guard is the era's own: while a capsule is armed, the
                 wheel is a BIND (the host arm swallows it) — never a scroll. -->
            <Frame name="$parentScrollFrame" inherits="BenillaFauxScrollFrameTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentBindingsBox"><Offset><AbsDimension x="8" y="-8"/></Offset></Anchor>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$parentBindingsBox"><Offset><AbsDimension x="-26" y="8"/></Offset></Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        BenillaFauxScrollFrame_OnLoad(this)
                        this.updateFunc = KeyBindingFrame_Update
                    </OnLoad>
                    <OnMouseWheel>
                        if not KeyBindingFrame.selected then
                            BenillaFauxScrollFrame_OnMouseWheel(this, arg1)
                        end
                    </OnMouseWheel>
                </Scripts>
            </Frame>
