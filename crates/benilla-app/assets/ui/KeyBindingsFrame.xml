    <!-- One CATEGORY row — the options window's 1.14 list-button wash law verbatim (0984:
         ONE UI-QuestLogTitleHighlight quad in ADD, steel-blue hover / locked gold selection,
         white text both ways; the era KeybindingsCategoryListButtonTemplate is the same
         OptionsListButtonTemplate family). 175 wide at the era sidebar seat. -->
    <Button name="KeyBindingsCategoryRowTemplate" virtual="true" hidden="true">
        <Size><AbsDimension x="175" y="20"/></Size>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentBg" file="Interface\QuestFrame\UI-QuestLogTitleHighlight" alphaMode="ADD" hidden="true">
                    <Size><AbsDimension x="163" y="21"/></Size>
                    <Anchors><Anchor point="CENTER"/></Anchors>
                </Texture>
            </Layer>
        </Layers>
        <ButtonText name="$parentText" justifyH="LEFT">
