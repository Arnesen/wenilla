        <HighlightFont inherits="GameFontHighlight"/>
        <DisabledFont inherits="GameFontDisable"/>
        <Scripts>
            <OnClick>KeyBindingsCategory_OnClick(this)</OnClick>
            <OnEnter>
                if KeyBindingFrame.selectedCategory ~= this.categoryIndex then
                    local bg = getglobal(this:GetName() .. "Bg")
                    bg:SetVertexColor(0.196, 0.388, 0.8)
                    bg:Show()
                end
            </OnEnter>
            <OnLeave>
                if KeyBindingFrame.selectedCategory ~= this.categoryIndex then
                    getglobal(this:GetName() .. "Bg"):Hide()
                end
            </OnLeave>
        </Scripts>
