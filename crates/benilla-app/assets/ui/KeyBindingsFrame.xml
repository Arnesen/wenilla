                </FontString>
                <Texture name="$parentColumnLine">
                    <Size><AbsDimension y="1"/></Size>
                    <Anchors>
                        <Anchor point="TOPLEFT"><Offset><AbsDimension x="221" y="-82"/></Offset></Anchor>
