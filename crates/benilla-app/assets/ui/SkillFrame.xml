                <Texture file="Interface\ClassTrainerFrame\UI-ClassTrainer-HorizontalBar">
                    <Size><AbsDimension x="75" y="16"/></Size>
                    <Anchors><Anchor point="LEFT" relativeTo="SkillHorizontalBarLeft" relativePoint="RIGHT"/></Anchors>
