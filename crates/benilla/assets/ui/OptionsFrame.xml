                     that color at the template's exact insets). -->
                <Texture name="$parentFlatBg">
                    <Anchors>
                        <Anchor point="TOPLEFT"><Offset><AbsDimension x="7" y="-18"/></Offset></Anchor>
                        <Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="-3" y="3"/></Offset></Anchor>
                    </Anchors>
                    <Color r="0.122" g="0.118" b="0.129" a="0.8"/>
