            <Button name="$parentGameTab">
                <Size><AbsDimension x="72" y="37"/></Size>
                <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="32" y="-27"/></Offset></Anchor></Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture name="$parentLeft" atlas="Options_Tab_Active_Left" useAtlasSize="true">
