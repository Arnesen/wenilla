                        <Scripts><OnLoad>OptionsCategoryRow_OnLoad(self, "Interface", "Interface")</OnLoad></Scripts>
                    </Button>
                    <Button name="$parentRowActionBars" inherits="OptionsCategoryRowTemplate">
                        <Anchors><Anchor point="TOPLEFT" relativeTo="$parentRowInterface" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-2"/></Offset></Anchor></Anchors>
                        <Scripts><OnLoad>OptionsCategoryRow_OnLoad(self, "ActionBars", "Action Bars")</OnLoad></Scripts>
                    </Button>
                    <Button name="$parentRowCombat" inherits="OptionsCategoryRowTemplate">
                        <Anchors><Anchor point="TOPLEFT" relativeTo="$parentRowActionBars" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-2"/></Offset></Anchor></Anchors>
                        <Scripts><OnLoad>OptionsCategoryRow_OnLoad(self, "Combat", "Combat")</OnLoad></Scripts>
                    </Button>
                    <Button name="$parentRowSocial" inherits="OptionsCategoryRowTemplate">
                        <Anchors><Anchor point="TOPLEFT" relativeTo="$parentRowCombat" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-2"/></Offset></Anchor></Anchors>
                        <Scripts><OnLoad>OptionsCategoryRow_OnLoad(self, "Social", "Social")</OnLoad></Scripts>
                    </Button>
                    <Button name="$parentRowKeybindings" inherits="OptionsCategoryRowTemplate">
                        <Anchors><Anchor point="TOPLEFT" relativeTo="$parentRowSocial" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-2"/></Offset></Anchor></Anchors>
                        <Scripts><OnLoad>OptionsCategoryRow_OnLoad(self, "Keybindings", "Keybindings")</OnLoad></Scripts>
                    </Button>
                    <!-- Nameplates — the era Gameplay group's own last row (NAMEPLATE_OPTIONS_LABEL,
                         order 15), backed by benilla's real nameplate knobs when the pages land. -->
                    <Button name="$parentRowNameplates" inherits="OptionsCategoryRowTemplate">
                        <Anchors><Anchor point="TOPLEFT" relativeTo="$parentRowKeybindings" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-2"/></Offset></Anchor></Anchors>
                        <Scripts><OnLoad>OptionsCategoryRow_OnLoad(self, "Nameplates", "Nameplates")</OnLoad></Scripts>
                    </Button>
                    <Frame name="$parentHeaderSystem" inherits="OptionsCategoryHeaderTemplate">
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeTo="$parentRowNameplates" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-22"/></Offset></Anchor>
                        </Anchors>
                        <Scripts>
                            <OnLoad>
                                getglobal(self:GetName() .. "Label"):SetText("System")
                                getglobal(self:GetName() .. "Bg"):SetAtlas("Options_CategoryHeader_2", true)
                            </OnLoad>
                        </Scripts>
                    </Frame>
                    <Button name="$parentRowGraphics" inherits="OptionsCategoryRowTemplate">
                        <Anchors><Anchor point="TOPLEFT" relativeTo="$parentHeaderSystem" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-2"/></Offset></Anchor></Anchors>
                        <Scripts><OnLoad>OptionsCategoryRow_OnLoad(self, "Graphics", "Graphics")</OnLoad></Scripts>
                    </Button>
                    <Button name="$parentRowAudio" inherits="OptionsCategoryRowTemplate">
                        <Anchors><Anchor point="TOPLEFT" relativeTo="$parentRowGraphics" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-2"/></Offset></Anchor></Anchors>
                        <Scripts><OnLoad>OptionsCategoryRow_OnLoad(self, "Audio", "Audio")</OnLoad></Scripts>
                    </Button>
                </Frames>
            </Frame>

            <!-- ── The page area (era SettingsList's header; the body is next slice's) ─────── -->
            <Frame name="$parentContainer">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentCategoryList" relativePoint="TOPRIGHT"><Offset><AbsDimension x="16" y="0"/></Offset></Anchor>
                    <Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="-22" y="47"/></Offset></Anchor>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture name="$parentDivider" atlas="Options_HorizontalDivider" useAtlasSize="true">
                            <Anchors><Anchor point="TOP"><Offset><AbsDimension x="0" y="-50"/></Offset></Anchor></Anchors>
                        </Texture>
                    </Layer>
                    <Layer level="OVERLAY">
                        <!-- The page title — OptionsFrame_SelectCategory writes it. -->
                        <FontString name="$parentTitle" inherits="OptionsFontHighlightHuge">
                            <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="7" y="-22"/></Offset></Anchor></Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <Frames>
                    <!-- Disabled this slice: there are no setting rows yet, so there is nothing
                         to default. Goes live with the pages (delete the Disable, wire the
                         per-page reset). -->
                    <Button name="$parentDefaults" inherits="OptionsRedButtonTemplate" text="Defaults">
                        <Anchors><Anchor point="TOPRIGHT"><Offset><AbsDimension x="-36" y="-16"/></Offset></Anchor></Anchors>
                        <Scripts><OnLoad>self:Disable()</OnLoad></Scripts>
                    </Button>
                    <!-- The page body — EMPTY this slice; the setting rows (Blizzard_SettingControls'
                         280x26 label/control rows, backed by real benilla knobs) land here next. -->
                    <Frame name="$parentBody">
                        <Anchors>
                            <Anchor point="TOPLEFT"><Offset><AbsDimension x="0" y="-50"/></Offset></Anchor>
                            <Anchor point="BOTTOMRIGHT"/>
                        </Anchors>
                    </Frame>
                </Frames>
            </Frame>

            <!-- ── The search box (era SearchBoxTemplate → InputBoxVisualTemplate,
                 SecureUIPanelTemplates.xml l.42-67; filters NOTHING yet — SCOPE note): a 20-tall
                 THREE-slice of common-search-border atlases, vertically centered on the 22 box —
                 left cap 8x20 hung 5 outside, right cap 8x20 flush, middle stretched between —
                 plus the 10x10 magnifier at LEFT (1,-1) and a 17x17 clear button at RIGHT (-3)
                 that appears with text (ClearButtonMixin, cut to our placeholder machinery).
                 The first cut transcribed the LEGACY nine-piece Common-Input-Border instead —
                 its ink drew ~27 units tall against the reference's 18 and rode 4 units high:
                 the director's "search bar is too high" (capture-measured, 2026-08-04). -->
            <EditBox name="$parentSearchBox" autoFocus="false" letters="64">
                <Size><AbsDimension x="350" y="22"/></Size>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$parentContainer" relativePoint="TOPRIGHT"><Offset><AbsDimension x="4" y="20"/></Offset></Anchor>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture name="$parentBorderLeft" atlas="common-search-border-left">
                            <Size><AbsDimension x="8" y="20"/></Size>
                            <Anchors><Anchor point="LEFT"><Offset><AbsDimension x="-5" y="0"/></Offset></Anchor></Anchors>
                        </Texture>
                        <Texture name="$parentBorderRight" atlas="common-search-border-right">
                            <Size><AbsDimension x="8" y="20"/></Size>
                            <Anchors><Anchor point="RIGHT"><Offset><AbsDimension x="0" y="0"/></Offset></Anchor></Anchors>
                        </Texture>
                        <Texture name="$parentBorderMiddle" atlas="common-search-border-middle">
                            <Size><AbsDimension y="20"/></Size>
                            <Anchors>
                                <Anchor point="LEFT" relativeTo="$parentBorderLeft" relativePoint="RIGHT"/>
                                <Anchor point="RIGHT" relativeTo="$parentBorderRight" relativePoint="LEFT"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                    <Layer level="ARTWORK">
                        <!-- The "Search" placeholder (era instructions label: GameFontDisableSmall
                             tinted 0.35). OnTextChanged below toggles it on first text. -->
                        <FontString name="$parentInstructions" inherits="GameFontDisableSmall" justifyH="LEFT" text="Search">
                            <Anchors>
                                <Anchor point="TOPLEFT"><Offset><AbsDimension x="16" y="0"/></Offset></Anchor>
                                <Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="-20" y="0"/></Offset></Anchor>
                            </Anchors>
                            <Color r="0.35" g="0.35" b="0.35"/>
                        </FontString>
                    </Layer>
                    <Layer level="OVERLAY">
                        <Texture name="$parentSearchIcon" atlas="common-search-magnifyingglass">
                            <Size><AbsDimension x="10" y="10"/></Size>
                            <Anchors><Anchor point="LEFT"><Offset><AbsDimension x="1" y="-1"/></Offset></Anchor></Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <Frames>
                    <!-- The clear X (era ClearButtonMixin: shown while text exists, half-alpha
                         icon, click wipes). Shown/hidden by the box's OnTextChanged below. -->
                    <Button name="$parentClearButton" hidden="true">
                        <Size><AbsDimension x="17" y="17"/></Size>
                        <Anchors><Anchor point="RIGHT"><Offset><AbsDimension x="-3" y="0"/></Offset></Anchor></Anchors>
                        <Layers>
                            <Layer level="ARTWORK">
                                <Texture name="$parentIcon" atlas="common-search-clearbutton" alpha="0.5">
                                    <Size><AbsDimension x="10" y="10"/></Size>
                                    <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="3" y="-3"/></Offset></Anchor></Anchors>
                                </Texture>
                            </Layer>
                        </Layers>
                        <Scripts>
                            <OnClick>
                                OptionsFrameSearchBox:SetText("")
                                OptionsFrameSearchBox:ClearFocus()
                            </OnClick>
                        </Scripts>
                    </Button>
                </Frames>
                <TextInsets><AbsInset left="16" right="20" top="0" bottom="0"/></TextInsets>
                <Scripts>
                    <!-- Placeholder + clear-button toggle only — no filtering behind it yet
                         (SCOPE note). -->
                    <OnTextChanged>
                        if this:GetText() == "" then
                            OptionsFrameSearchBoxInstructions:Show()
                            OptionsFrameSearchBoxClearButton:Hide()
                        else
                            OptionsFrameSearchBoxInstructions:Hide()
                            OptionsFrameSearchBoxClearButton:Show()
                        end
                    </OnTextChanged>
                    <OnEscapePressed>this:ClearFocus()</OnEscapePressed>
                </Scripts>
                <FontString inherits="GameFontHighlightSmall"/>
            </EditBox>

            <!-- ── Close, both spellings ───────────────────────────────────────────────────── -->
            <!-- The X — hung past the top-right corner like the era's ClosePanelButton, on the
                 1.12 minimize-ball art (header SCOPE note; the LootFrame close idiom). -->
            <Button name="$parentClosePanelButton">
                <Size><AbsDimension x="32" y="32"/></Size>
                <Anchors><Anchor point="TOPRIGHT"><Offset><AbsDimension x="4" y="4"/></Offset></Anchor></Anchors>
                <NormalTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Up"/>
                <PushedTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Down"/>
                <HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD"/>
                <Scripts>
                    <OnClick>
                        PlaySound("igMainMenuClose")
                        HideUIPanel(OptionsFrame)
                    </OnClick>
                </Scripts>
            </Button>
            <!-- The red Close (era SettingsPanel.CloseButton; Apply is deliberately absent — we
                 apply live, there is never a pending change to hold). -->
            <Button name="$parentCloseButton" inherits="OptionsRedButtonTemplate" text="Close">
                <Anchors><Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="-16" y="16"/></Offset></Anchor></Anchors>
                <Scripts>
                    <OnClick>
                        PlaySound("igMainMenuClose")
                        HideUIPanel(OptionsFrame)
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>
        <Scripts>
            <!-- Controls is the default page; a re-opened window keeps its last selection (the
                 era remembers too — Settings.OpenToCategory's default seat). The scale re-fits
                 on every show — the era panel manager re-runs checkFit the same way. -->
            <OnShow>
                OptionsFrame_UpdateScale()
                OptionsFrame_SelectCategory(this.selectedCategory or "Controls")
            </OnShow>
        </Scripts>
    </Frame>
</Ui>
