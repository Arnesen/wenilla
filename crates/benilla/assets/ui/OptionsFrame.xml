                     Classic/SharedUIPanelTemplates.xml l.78: Interface\FrameGeneral\_UI-Frame —
                     era-only, manifest fdid 374157 — 256x17 horizTile). STRETCHED (SCOPE note). -->
                <Texture name="$parentTitleBg" file="era:textures/374157.blp">
                    <Size><AbsDimension y="17"/></Size>
                    <Anchors>
                        <Anchor point="TOPLEFT"><Offset><AbsDimension x="8" y="-3"/></Offset></Anchor>
                        <Anchor point="TOPRIGHT"><Offset><AbsDimension x="0" y="-3"/></Offset></Anchor>
                    </Anchors>
                    <TexCoords left="0" right="1" top="0.2890625" bottom="0.421875"/>
                </Texture>
            </Layer>
            <Layer level="BORDER">
                <!-- The ButtonFrameTemplateNoPortrait nine-slice, unrolled (NineSliceLayouts.lua
                     l.132 + NineSlice.lua's edge anchoring): corners at their corners at atlas
                     size; each edge pinned between its two corners on the anchored axis, its
                     other axis staying the atlas size. The three tile edges + the top band are
                     STRETCHED (SCOPE note). -->
                <Texture name="$parentTopLeftCorner" atlas="UI-Frame-TopLeftCornerNoPortrait" useAtlasSize="true">
                    <Anchors><Anchor point="TOPLEFT"/></Anchors>
                </Texture>
                <Texture name="$parentTopRightCorner" atlas="UI-Frame-TopCornerRight" useAtlasSize="true">
                    <Anchors><Anchor point="TOPRIGHT"/></Anchors>
                </Texture>
                <Texture name="$parentBotLeftCorner" atlas="UI-Frame-BotCornerLeft" useAtlasSize="true">
                    <Anchors><Anchor point="BOTTOMLEFT"/></Anchors>
                </Texture>
                <Texture name="$parentBotRightCorner" atlas="UI-Frame-BotCornerRight" useAtlasSize="true">
                    <Anchors><Anchor point="BOTTOMRIGHT"/></Anchors>
                </Texture>
                <Texture name="$parentTopEdge" atlas="_UI-Frame-TitleTile" useAtlasSize="true">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="$parentTopLeftCorner" relativePoint="TOPRIGHT"/>
                        <Anchor point="TOPRIGHT" relativeTo="$parentTopRightCorner" relativePoint="TOPLEFT"/>
                    </Anchors>
                </Texture>
                <Texture name="$parentBotEdge" atlas="_UI-Frame-Bot" useAtlasSize="true">
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" relativeTo="$parentBotLeftCorner" relativePoint="BOTTOMRIGHT"/>
                        <Anchor point="BOTTOMRIGHT" relativeTo="$parentBotRightCorner" relativePoint="BOTTOMLEFT"/>
                    </Anchors>
                </Texture>
                <Texture name="$parentLeftEdge" atlas="!UI-Frame-LeftTile" useAtlasSize="true">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="$parentTopLeftCorner" relativePoint="BOTTOMLEFT"/>
                        <Anchor point="BOTTOMLEFT" relativeTo="$parentBotLeftCorner" relativePoint="TOPLEFT"/>
                    </Anchors>
                </Texture>
                <!-- The right edge. The era layout's odd x=-8 / x1=8 pair (NineSliceLayouts
                     l.139) puts DIFFERENT x on the tile's two corner anchors — the reference
                     engine draws the quad through its anchor points, so the era tile is a
                     barely-visible lean (top 8 left, bottom 8 right; mean = flush at the frame
                     edge, which is exactly how the live window reads — director's capture,
                     2026-08-04). This engine's regions are axis-aligned rects, so we author the
                     MEAN: both corners flush (x=0). The first cut gave the whole tile to the
                     -8 anchor instead — the border floated 8 units into the panel with a dark
                     gap at the true edge, the director's "right border looks off". -->
                <Texture name="$parentRightEdge" atlas="!UI-Frame-RightTile" useAtlasSize="true">
                    <Anchors>
                        <Anchor point="TOPRIGHT" relativeTo="$parentTopRightCorner" relativePoint="BOTTOMRIGHT"/>
                        <Anchor point="BOTTOMRIGHT" relativeTo="$parentBotRightCorner" relativePoint="TOPRIGHT"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <!-- The inner dark panel — the one big era piece, at its full atlas size. -->
                <Texture name="$parentInnerFrame" atlas="Options_InnerFrame" useAtlasSize="true">
                    <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="17" y="-64"/></Offset></Anchor></Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString name="$parentTitleText" inherits="GameFontNormal" text="Options">
                    <Anchors><Anchor point="TOP"><Offset><AbsDimension x="0" y="-5"/></Offset></Anchor></Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <!-- ── Tabs — the era MinimalTabTemplate plates (SharedXML Shared/Tabs/MinimalTab
