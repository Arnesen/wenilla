            <!-- ── The category list (era CategoryList, static — it fits) ──────────────────── -->
            <Frame name="$parentCategoryList">
                <Size><AbsDimension x="199"/></Size>
                <Anchors>
                    <Anchor point="TOPLEFT"><Offset><AbsDimension x="18" y="-76"/></Offset></Anchor>
                    <Anchor point="BOTTOMLEFT"><Offset><AbsDimension x="18" y="46"/></Offset></Anchor>
                </Anchors>
                <!-- The era list rhythm (CreateScrollBoxListLinearView spacing=2 + the 18-tall
                     SettingsCategoryListSpacerTemplate between groups): 2 between every
                     element, 2+18+2 = 22 from a group's last row to the next header. -->
                <Frames>
                    <Frame name="$parentHeaderGameplay" inherits="OptionsCategoryHeaderTemplate">
                        <Anchors><Anchor point="TOPLEFT"/></Anchors>
                        <Scripts>
                            <OnLoad>
                                getglobal(self:GetName() .. "Label"):SetText("Gameplay")
